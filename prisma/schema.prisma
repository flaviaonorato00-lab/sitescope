generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id        String   @id @default(cuid())
  url       String   @unique
  hostname  String
  createdAt DateTime @default(now())
  audits    Audit[]
}

model Audit {
  id            String   @id @default(cuid())
  strategy      String
  performance   Int
  accessibility Int
  seo           Int
  bestPractices Int
  issues        Json?
  createdAt     DateTime @default(now())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}